{
  "name": "Dotfiles for kiririmode",
  "build": {
    "dockerfile": "Dockerfile",
    "options": [
      "--no-cache"
    ]
  },
  "features": {
    "ghcr.io/devcontainers-extra/features/direnv:1": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "settings": {
        "editor.formatOnSave": true,
        "editor.formatOnPaste": true,
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.codeActionsOnSave": {
          "source.organizeImports": "explicit"
        },
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "files.trimFinalNewlines": true,
        "files.autoSave": "onFocusChange"
      },
      "extensions": [
        "ms-vscode.makefile-tools"
      ]
    }
  },
  "postCreateCommand": "echo 'eval \"$(direnv hook bash)\"' >> ~/.bashrc && pre-commit install",
  "postStartCommand": "command -v claude >/dev/null 2>&1 || curl -fsSL https://claude.ai/install.sh | bash",
  "mounts": [
    "source=${localEnv:HOME}/.claude/settings.json,target=/home/vscode/.claude/settings.json,type=bind,consistency=cached"
  ],
  "remoteUser": "vscode"
}
