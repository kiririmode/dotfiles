#!/bin/bash
# -*- mode: shell-script -*-

function directory() {
    if [[ $# == 0 ]]; then
        return 1
    fi

    local file cwd

    file="$(basename "$1")"
    # This function runs in a $(...) subshell, so cd does not affect the caller.
    # Keep the current behavior on cd failure instead of adding "|| return".
    # shellcheck disable=SC2164
    cd "$(dirname "$1")"

    # recursively
    while [ -L "$file" ]; do
        # read link
        file="$(command readlink "$file")"
        # shellcheck disable=SC2164
        cd "$(dirname "$file")"
        file="$(basename "$file")"
    done

    # physical current working directory (all symbolic links resolved).
    cwd="$(pwd -P)"

    # puts
    echo "${cwd}"
}

dotpath="$(directory "$0")"
export DOTPATH=$dotpath
